ENVIRONMENT=development
DEBUG=true
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://surfacewatch:surfacewatch@localhost:5432/surfacewatch
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:3000"]
ALLOW_INTERNAL_TARGETS=false
SCAN_TIMEOUT_SECONDS=3
SCAN_CONCURRENCY=5
INLINE_SCAN_RUNNER=true
AGGRESSIVE_MAX_DISCOVERED_ASSETS=500
# Optional comma-separated override for explicit aggressive scans.
# AGGRESSIVE_PORTS=20,21,22,23,25,53,80,110,143,389,443,445,465,587,993,995,1433,1521,2049,2375,2376,3000,3306,5000,5432,5601,5900,5984,6379,8000,8080,8443,9000,9200,9300,11211,27017,27018
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
