ENVIRONMENT=development
DEBUG=true
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://surfacewatch:surfacewatch@localhost:5432/surfacewatch
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000"]
ALLOW_INTERNAL_TARGETS=false
SCAN_TIMEOUT_SECONDS=3
DISCOVERY_TIMEOUT_SECONDS=10
SCAN_CONCURRENCY=5
PORT_SCAN_CONCURRENCY=20
ASSET_TIMEOUT_SECONDS=45
AGGRESSIVE_ASSET_TIMEOUT_SECONDS=120
MAX_HTTP_BODY_BYTES=65536
MAX_EXPOSURE_ENDPOINTS=12
MAX_SCAN_DURATION_SECONDS=600
MAX_DISCOVERED_ASSETS=250
INLINE_SCAN_RUNNER=true
AGGRESSIVE_MAX_DISCOVERED_ASSETS=500
# Optional comma-separated override for explicit aggressive scans.
# AGGRESSIVE_PORTS=20,21,22,23,25,53,80,81,110,111,135,139,143,389,443,445,465,587,993,995,1433,1521,1883,2049,2181,2375,2376,2379,2380,3000,3128,3306,3389,4443,5000,5432,5601,5672,5900,5984,6379,6443,7001,7002,8000,8080,8081,8443,8500,8888,9000,9090,9200,9300,9418,9443,10000,10250,10255,11211,15672,27017,27018
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
